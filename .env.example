APP_ENV=development
APP_NAME=Novel Signal API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://novel_signal:novel_signal@localhost:5432/novel_signal
INTERNAL_AUTH_SECRET=replace-with-a-long-random-secret
# Deprecated: dashboard access-code auth is removed from the production path.
# Supabase Auth is the only identity provider. Do not set this in production.
DASHBOARD_ACCESS_CODE=
DASHBOARD_AUTH_COOKIE=novel_signal_dashboard
# Supabase Auth (only identity provider; no service-role key in the app).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_ISSUER=
SUPABASE_AUDIENCE=authenticated
FRONTEND_URL=http://localhost:3000
# One-time development migration window only. MUST stay false in production:
# email is display-only, never an identity key (see docs/auth/supabase.md).
AUTH_ALLOW_EMAIL_FALLBACK_LINKING=false
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=novel-signal-raw
OBJECT_STORE_ACCESS_KEY=novel_signal
OBJECT_STORE_SECRET_KEY=novel_signal_dev
OBJECT_STORE_REGION=ap-south-1
RAW_EVIDENCE_SIGNING_TTL_SECONDS=900
AMAZON_IN_CONCURRENCY=1
AMAZON_IN_MIN_DELAY_SECONDS=8
AMAZON_IN_MAX_DELAY_SECONDS=15
GOOGLE_SERP_CONCURRENCY=1
GOOGLE_SERP_MIN_DELAY_SECONDS=8
GOOGLE_SERP_GEO_CODE=IN
GOOGLE_SERP_DEVICE_PROFILE=desktop
GOOGLE_SERP_LOCALE=en-IN
GOOGLE_SERP_TIMEZONE_ID=Asia/Kolkata
GOOGLE_SERP_NOVEL_DOMAINS=
GOOGLE_SERP_COMPETITOR_DOMAINS=
COLLECTOR_TIMEOUT_SECONDS=45
COLLECTOR_MAX_ATTEMPTS=3
COLLECTION_BATCH_SIZE=50
INTERNAL_SCHEDULER_ENABLED=true
INTERNAL_SCHEDULER_INTERVAL_SECONDS=60
SENTRY_DSN=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Amazon SP-API and Brand Analytics reports
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
AMAZON_AWS_ACCESS_KEY_ID=
AMAZON_AWS_SECRET_ACCESS_KEY=
AMAZON_ROLE_ARN=
AMAZON_REGION=eu-west-1
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV

# Amazon Ads API
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_IDS=

# Google Search Console
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON=
GOOGLE_SEARCH_CONSOLE_SITES=

# Google Ads API (Novel-owned accounts)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta Marketing API and Ad Library
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=
META_AD_LIBRARY_ACCESS_TOKEN=
